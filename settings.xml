          <id>sds-nexus-maven-public</id>
          <url>http://nexus.sdsdev.co.kr:8081/repository/maven-public/</url>
        </pluginRepository>
        <pluginRepository>
          <id>jenkins-public</id>
          <url>http://nexus.sdsdev.co.kr:8081/repository/jenkins-ci-release/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>sds-nexus</activeProfile>
  </activeProfiles>
</settings>
