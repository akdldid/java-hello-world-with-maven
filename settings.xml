        </repository>
        <repository>
          <id>jenkins-public</id>
          <url>http://nexus.sdsdev.co.kr:8081/repository/jenkins-ci-release/</url>
        </repository>
        <repository>
          <id>jenkins-releases</id>
          <url>http://nexus.sdsdev.co.kr:8081/repository/jenkins-releases</url>
        </repository>
      </repositories>
      <pluginRepositories>
